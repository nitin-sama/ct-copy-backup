{
  // Must match your Worker's name in the Cloudflare dashboard (Workers & Pages list).
  "name": "ct-copy-backup",
  "main": "_worker.js",
  // 2026-03-24 or later is needed for browser rendering.
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Real headless browser for pages built by JavaScript (free plan: 10 minutes a day).
  // If a deploy ever complains about "browser", delete this block; everything else still works.
  "browser": {
    "binding": "BROWSER"
  },
  // Keep variables you set in the dashboard, such as ALLOWED_HOSTS, on every deploy.
  "keep_vars": true
}
