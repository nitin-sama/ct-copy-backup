{
  // Must match your Worker's name in the Cloudflare dashboard (Workers & Pages list).
  "name": "copy-backup",
  "main": "_worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables you set in the dashboard, such as ALLOWED_HOSTS, on every deploy.
  "keep_vars": true
}
